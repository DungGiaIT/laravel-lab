  "item": [
    {
      "name": "Categories - list",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns category collection', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/categories"
      }
    },
    {
      "name": "Categories - page 2",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('paginates to page 2', function () {",
              "    const body = pm.response.json();",
              "    pm.response.to.have.status(200);",
              "    pm.expect(body.current_page).to.eql(2);",
              "    pm.expect(body.data.length).to.be.greaterThan(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/categories?page=2"
      }
    },
    {
      "name": "Categories - search",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('search matches category names', function () {",
              "    const body = pm.response.json();",
              "    pm.response.to.have.status(200);",
              "    pm.expect(body.data.length).to.be.greaterThan(0);",
              "    pm.expect(body.data.every(function (item) { return item.name.toLowerCase().includes('cafe'); })).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/categories?search=Cafe"
      }
    },
    {
      "name": "Categories - create",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('creates a category', function () {",
              "    pm.response.to.have.status(201);",
              "    pm.collectionVariables.set('categoryId', pm.response.json().id);",
              "    pm.expect(pm.response.json().name).to.include('Postman Category');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Category {{$guid}}\",\n  \"description\": \"Created by the Postman collection\"\n}"
        },
        "url": "{{base_url}}/categories"
      }
    },
    {
      "name": "Categories - show",
