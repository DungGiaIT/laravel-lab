    {
      "name": "Products - sort price ascending",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('sorts prices ascending', function () {",
              "    const prices = pm.response.json().data.map(function (item) { return Number(item.price); });",
              "    pm.response.to.have.status(200);",
              "    pm.expect(prices.length).to.be.greaterThan(0);",
              "    pm.expect(prices).to.eql(prices.slice().sort(function (a, b) { return a - b; }));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
