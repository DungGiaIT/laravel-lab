{
  "info": {
    "name": "Coffee Shop API v1",
    "description": "CRUD, validation, pagination, search, relation loading, and price sorting checks for the Laravel lab API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
